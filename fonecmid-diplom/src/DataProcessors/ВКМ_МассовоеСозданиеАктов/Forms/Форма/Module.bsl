
#Область ОбработчикиКомандФормы

//+++ВКМ_Макаренко В.П. 26.08.2026
&НаКлиенте
Процедура Заполнить(Команда)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	СписокДокументов.Очистить();
	
	ПараметрыВыполнения = НачатьЗаполнениеНаСервере();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = "Пожалуйста, подождите. Идет подбор договоров и документов...";
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Ложь;
	
	ОповещениеЗавершения = Новый ОписаниеОповещения("ЗаполнитьЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ПараметрыВыполнения, ОповещениеЗавершения, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументы(Команда)
	
	Если СписокДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Структура = Новый Структура("ДокРеализацияТоваровУслуг", ПредопределенноеЗначение("Документ.РеализацияТоваровУслуг.ПустаяСсылка"));
	ДоговорыБезРеализации = СписокДокументов.НайтиСтроки(Структура);

	ДанныеДляСоздания = Новый Массив;
	
	Для Каждого Строка Из ДоговорыБезРеализации Цикл
		
		Данные = ПолучитьДанныеЗаполнения(Строка.Договор);
		
		СтруктураСтроки = Новый Структура;
		СтруктураСтроки.Вставить("Договор", Строка.Договор);
		СтруктураСтроки.Вставить("Контрагент", Данные.Владелец);
		СтруктураСтроки.Вставить("Организация", Данные.Организация);
		СтруктураСтроки.Вставить("Дата", КонецМесяца(Период.ДатаНачала));
		
		ДанныеДляСоздания.Добавить(СтруктураСтроки);
		
	КонецЦикла;
	
	Если ДанныеДляСоздания.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Документы реализации уже созданы для выбранных договоров");
		Возврат;
	КонецЕсли;
	
	ПараметрыВыполнения = НачатьСозданиеДокументовНаСервере(ДанныеДляСоздания);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = "Пожалуйста, подождите. Идет массовое создание документов...";
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Ложь;
	
	ОповещениеЗавершения = Новый ОписаниеОповещения("СоздатьДокументыЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ПараметрыВыполнения, ОповещениеЗавершения, ПараметрыОжидания);
		
КонецПроцедуры
//---ВКМ_Макаренко В.П. 26.08.2026

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция НачатьЗаполнениеНаСервере()
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Заполнение списка договоров для создания актов";
	
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ПериодНачало", Период.ДатаНачала);
	ПараметрыЗадания.Вставить("ПериодКонец", Период.ДатаОкончания);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("ВКМ_ФоновыеЗаданияВызовСервера.ЗаполнитьСписокДокументовФоновое", ПараметрыЗадания, ПараметрыВыполнения);
		
КонецФункции

&НаКлиенте
Процедура ЗаполнитьЗавершение(РезультатЗадания, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗадания = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатЗадания.Статус = "Выполнено" Тогда
		
		ЗагрузитьРезультатЗаполненияНаСервере(РезультатЗадания.АдресРезультата);
		
	ИначеЕсли РезультатЗадания.Статус = "Ошибка" Тогда
		
		ТекстОшибки = "Произошла ошибка при заполнении списка договоров.";
		
		Попытка
			ТекстОшибки = Строка(РезультатЗадания.КраткоеПредставлениеОшибки);
		Исключение
		КонецПопытки;
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьРезультатЗаполненияНаСервере(АдресРезультата)
	
	МассивСтрок = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Если ТипЗнч(МассивСтрок) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	СписокДокументов.Очистить(); 
	
	Для Каждого ДанныеСтроки Из МассивСтрок Цикл
		НоваяСтрока = СписокДокументов.Добавить();
		НоваяСтрока.Договор = ДанныеСтроки.Договор;
		НоваяСтрока.ДокРеализацияТоваровУслуг = ДанныеСтроки.Документ;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеЗаполнения(Договор)
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "Владелец, Организация");	
КонецФункции

&НаСервере
Функция НачатьСозданиеДокументовНаСервере(ДанныеДляСоздания)
	
	Массив = Новый Массив;
	Для Каждого Стр Из ДанныеДляСоздания Цикл
		НоваяСтр = Новый Структура;
		НоваяСтр.Вставить("Договор",      Стр.Договор);
		НоваяСтр.Вставить("Контрагент",   Стр.Контрагент);
		НоваяСтр.Вставить("Организация",  Стр.Организация);
		НоваяСтр.Вставить("Дата",         Стр.Дата);
		Массив.Добавить(НоваяСтр);
	КонецЦикла;
	
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	ПараметрыДляФона = Новый Структура("ДанныеДляСоздания", Массив);
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(ПараметрыДляФона); 
	МассивПараметров.Добавить(АдресРезультата);  
	
	ИмяЭкспортногоМетода = "ВКМ_ФоновыеЗаданияВызовСервера.СоздатьДокументыФоновое";
	
	Задание = ФоновыеЗадания.Выполнить(ИмяЭкспортногоМетода, МассивПараметров, , "Массовое создание актов реализации");
	
	РезультатБСП = Новый Структура;
	РезультатБСП.Вставить("ИдентификаторЗадания", Задание.УникальныйИдентификатор);
	РезультатБСП.Вставить("АдресРезультата",     АдресРезультата);
	РезультатБСП.Вставить("Статус",              "Выполняется");
	
	Возврат РезультатБСП;
	
КонецФункции

&НаКлиенте
Процедура СоздатьДокументыЗавершение(РезультатЗадания, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗадания = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатЗадания.Статус = "Выполнено" Тогда
		
		СтруктураРезультата = ПолучитьРезультатНаСервере(РезультатЗадания.АдресРезультата);
		
		Если ТипЗнч(СтруктураРезультата) = Тип("Структура") Тогда
			КоличествоСоздано = СтруктураРезультата.УспешноСоздано;
		Иначе
			КоличествоСоздано = 0;
		КонецЕсли;
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Процесс завершен. Успешно создано документов: %1", КоличествоСоздано));

		Заполнить(Неопределено); 
		
	ИначеЕсли РезультатЗадания.Статус = "Ошибка" Тогда
		
		ТекстОшибки = "Произошла ошибка при выполнении фонового задания массового создания документов.";
		
		Попытка
			ТекстОшибки = Строка(РезультатЗадания.КраткоеПредставлениеОшибки);
		Исключение
		КонецПопытки;
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРезультатНаСервере(АдресРезультата)
	Возврат ПолучитьИзВременногоХранилища(АдресРезультата);
КонецФункции
