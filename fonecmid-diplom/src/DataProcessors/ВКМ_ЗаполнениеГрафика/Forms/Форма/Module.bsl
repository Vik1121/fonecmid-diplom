#Область СлужебныеПроцедурыИФункции

//+++ВКМ_Макаренко В.П. 04.09.2026
&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Курсор = Период.ДатаНачала;
	Пока Курсор < Период.ДатаОкончания Цикл
		Запись = РегистрыСведений.ВКМ_Календарь.СоздатьМенеджерЗаписи();
		Запись.Дата = Курсор;
		Если ДеньНедели(Курсор) <= 5 Тогда
			Запись.РабочийДень = 1;
		КонецЕсли;
		Запись.Записать();
		Курсор = Курсор + 86400;
	КонецЦикла;
	
КонецПроцедуры
//---ВКМ_Макаренко В.П. 04.09.2026

#КонецОбласти