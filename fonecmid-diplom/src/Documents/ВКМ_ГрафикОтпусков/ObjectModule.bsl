Процедура ОбработкаПроведения(Отказ, Режим)

	// регистр ВКМ_ОстаткиОтпуска Приход
	Движения.ВКМ_ОстаткиОтпуска.Записывать = Истина;
	Для Каждого ТекСтрокаОтпускаСотрудников Из ОтпускаСотрудников Цикл
		Движение = Движения.ВКМ_ОстаткиОтпуска.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = НачалоГода(Год);
		Движение.Сотрудник = ТекСтрокаОтпускаСотрудников.Сотрудник;
		Движение.КоличествоДней = ТекСтрокаОтпускаСотрудников.ДнейОтпуска;
	КонецЦикла;

КонецПроцедуры
