#Область ОбработчикиСобытийЭлементовТаблицыФормыОтпускаСотрудников

//+++ВКМ_Макаренко В.П. 28.09.2026
&НаКлиенте
Процедура ОтпускаСотрудниковДатаНачалаПриИзменении(Элемент)
	
	ТекСтрока = Элементы.ОтпускаСотрудников.ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(ТекСтрока.ДатаОкончания) ИЛИ НЕ ЗначениеЗаполнено(ТекСтрока.ДатаНачала) Тогда
		ТекСтрока.ДнейОтпуска = 0;
	КонецЕсли;
	
	Если НЕ ТекСтрока.ДнейОтпуска = 0 Тогда
		ПосчитатьКоличествоДнейОтпуска(ТекСтрока);
	КонецЕсли;
	
	ОбновитьУсловноеОформлениеТЧ();
		
КонецПроцедуры

&НаКлиенте
Процедура ОтпускаСотрудниковДатаОкончанияПриИзменении(Элемент)
		
	ТекСтрока = Элементы.ОтпускаСотрудников.ТекущиеДанные;
	
	Отказ = Ложь;
	
	Если НЕ ЗначениеЗаполнено(ТекСтрока.ДатаОкончания) ИЛИ НЕ ЗначениеЗаполнено(ТекСтрока.ДатаНачала) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Заполните даты начала и окончания отпуска");
		ТекСтрока.ДнейОтпуска = 0;
		Отказ = Истина;
	КонецЕсли;
	
	Если ТекСтрока.ДатаНачала > ТекСтрока.ДатаОкончания Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Дата окончания отпуска не может быть меньше начала");
		ТекСтрока.ДатаОкончания = Дата(1, 1, 1);
		Отказ = Истина;
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		ПосчитатьКоличествоДнейОтпуска(ТекСтрока);
	КонецЕсли;
	
	ОбновитьУсловноеОформлениеТЧ();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтпускаСотрудниковПослеУдаления(Элемент)
	ОбновитьУсловноеОформлениеТЧ();	
КонецПроцедуры

&НаКлиенте
Процедура ОтпускаСотрудниковПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если Копирование Тогда
		ОбновитьУсловноеОформлениеТЧ();	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтпускаСотрудниковПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ОбновитьУсловноеОформлениеТЧ();
КонецПроцедуры
//---ВКМ_Макаренко В.П. 28.09.2026

#КонецОбласти

#Область ОбработчикиКомандФормы

//+++ВКМ_Макаренко В.П. 28.09.2026
&НаКлиенте
Процедура ДиаграммаГанта(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Год) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Заполните год для построения графика",, "Объект.Год");
		Возврат;
	КонецЕсли;
	
	АдресХранилища = ПодготовитьДанныеДляДиаграммы();
	
    ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресДанных", АдресХранилища);
	ПараметрыФормы.Вставить("Год", Объект.Год);
	
	ОткрытьФорму("Документ.ВКМ_ГрафикОтпусков.Форма.АнализГрафика", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры
//---ВКМ_Макаренко В.П. 28.09.2026

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//+++ВКМ_Макаренко В.П. 28.09.2026
&НаКлиенте
Процедура ПосчитатьКоличествоДнейОтпуска(ТекСтрока)
	ТекСтрока.ДнейОтпуска = (ТекСтрока.ДатаОкончания - ТекСтрока.ДатаНачала) / 86400 + 1;
КонецПроцедуры

&НаСервере
Функция ПодготовитьДанныеДляДиаграммы()
	
	ТаблицаДанных = Новый ТаблицаЗначений;
    ТаблицаДанных.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.ВКМ_Сотрудники"));
    ТаблицаДанных.Колонки.Добавить("ДатаНачала", Новый ОписаниеТипов("Дата"));
    ТаблицаДанных.Колонки.Добавить("ДатаОкончания", Новый ОписаниеТипов("Дата"));
    
    Для Каждого СтрокаОтпуска Из Объект.ОтпускаСотрудников Цикл
		
		НоваяСтрока = ТаблицаДанных.Добавить();
        НоваяСтрока.Сотрудник = СтрокаОтпуска.Сотрудник;
        НоваяСтрока.ДатаНачала = СтрокаОтпуска.ДатаНачала;
        НоваяСтрока.ДатаОкончания = СтрокаОтпуска.ДатаОкончания;
		
    КонецЦикла;
    
    Возврат ПоместитьВоВременноеХранилище(ТаблицаДанных, Новый УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ОбновитьУсловноеОформлениеТЧ()
	
	Для Сч = 0 По УсловноеОформление.Элементы.Количество() - 1 Цикл
		
		Индекс = УсловноеОформление.Элементы.Количество() - 1 - Сч;
		Если УсловноеОформление.Элементы[Индекс].Представление = "ПревышениеДнейОтпуска" Тогда
			УсловноеОформление.Элементы.Удалить(Индекс);
		КонецЕсли;
		
	КонецЦикла;
	
	ТЗ = Объект.ОтпускаСотрудников.Выгрузить(, "Сотрудник, ДнейОтпуска");
	ТЗ.Свернуть("Сотрудник", "ДнейОтпуска");
	
	Сотрудники = Новый СписокЗначений;
	
	Для Каждого Строка Из ТЗ Цикл
		Если ЗначениеЗаполнено(Строка.Сотрудник) И Строка.ДнейОтпуска > 28 Тогда
			Сотрудники.Добавить(Строка.Сотрудник);
		КонецЕсли;
	КонецЦикла;
	
	Если Сотрудники.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Создаем правило условного оформления
	ЭлементОформл = УсловноеОформление.Элементы.Добавить();
	ЭлементОформл.Представление = "ПревышениеДнейОтпуска";
	ЭлементОформл.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Розовый);
	
	ЭлементОтбора = ЭлементОформл.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ОтпускаСотрудников.Сотрудник");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ЭлементОтбора.ПравоеЗначение = Сотрудники;
	ЭлементОтбора.Использование = Истина;
	
	ОформляемоеПоле = ЭлементОформл.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ОтпускаСотрудников");
	ОформляемоеПоле.Использование = Истина;
	
КонецПроцедуры
//---ВКМ_Макаренко В.П. 28.09.2026

#КонецОбласти

