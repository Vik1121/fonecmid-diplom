&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Год") Тогда
		
		Год = Параметры.Год;
		
    КонецЕсли;
	
	Если Параметры.Свойство("АдресДанных") Тогда
		
		ТаблицаДанных = ПолучитьИзВременногоХранилища(Параметры.АдресДанных);
        ЗаполнитьДиаграмму(ТаблицаДанных);
        УдалитьИзВременногоХранилища(Параметры.АдресДанных);
		
    КонецЕсли;
	
КонецПроцедуры
//---ВКМ_Макаренко В.П. 28.09.2026

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//+++ВКМ_Макаренко В.П. 28.09.2026
Процедура ЗаполнитьДиаграмму(ТаблицаДанных)
	
	Диаграмма.Очистить();
	Диаграмма.Точки.Очистить();
	Диаграмма.Серии.Очистить();
	
	Серия = Диаграмма.Серии.Добавить();
    Серия.Текст = "Отпуск";
		
	Для Каждого Строка ИЗ ТаблицаДанных Цикл
		
		Если ЗначениеЗаполнено(Строка.Сотрудник) Тогда
			Точка = Диаграмма.УстановитьТочку(Строка.Сотрудник);
			Точка.Текст = Точка.Значение.Наименование;
		КонецЕсли;
		
		Значение = Диаграмма.ПолучитьЗначение(Точка, Серия);
		
		Если ЗначениеЗаполнено(Строка.ДатаНачала) И ЗначениеЗаполнено(Строка.ДатаОкончания) Тогда
			Интервал = Значение.Добавить();
			Интервал.Начало = Строка.ДатаНачала;
			Интервал.Конец = Строка.ДатаОкончания;
		КонецЕсли;
		
	КонецЦикла;
	
	Диаграмма.АвтоОпределениеПолногоИнтервала = Ложь;
	Диаграмма.УстановитьПолныйИнтервал(НачалоГода(Год), КонецГода(Год));
	
	// Добавляем элемент "Месяц"
	ШкалаВремени = Диаграмма.ОбластьПостроения.ШкалаВремени;
	ЭлементМесяц = ШкалаВремени.Элементы.Добавить();
	ЭлементМесяц.Единица = ТипЕдиницыШкалыВремени.Месяц;
	ЭлементМесяц.Кратность = 1; 

	ЭлементМесяц.Формат = "ДФ='ММММ'"; 
	ЭлементМесяц.ЛинииДелений = Новый Линия(ТипЛинииДиаграммы.Сплошная, 1);	
	
КонецПроцедуры
//---ВКМ_Макаренко В.П. 28.09.2026

#КонецОбласти

