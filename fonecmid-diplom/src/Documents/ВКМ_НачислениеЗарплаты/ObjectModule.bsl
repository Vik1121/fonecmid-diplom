
#Область ОбработчикиСобытий

//+++ВКМ_Макаренко В.П. 04.09.2026 
Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.ВКМ_ОсновныеНачисления.Очистить();
	
	Движения.ВКМ_ДополнительныеНачисления.Очистить();
	Движения.ВКМ_ДополнительныеНачисления.Записывать = Истина;
	
	ПланыВидовРасчетаОклад = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.Оклад;
	ПланыВидовРасчетаОтпуск = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.Отпуск;
	ПланыВидовРасчетаПремия = ПланыВидовРасчета.ВКМ_ДополнительныеНачисления.Премия;
	
	Движения.ВКМ_ОстаткиОтпуска.Записывать = Истина;
	
	Для Каждого ТекСтрокаНачисления Из Начисления Цикл
		
		// регистр ВКМ_ОстаткиОтпуска Расход
		Если ТекСтрокаНачисления.ВидРасчета = ПланыВидовРасчетаОтпуск Тогда
			Движение = Движения.ВКМ_ОстаткиОтпуска.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = Дата;
			Движение.Сотрудник = ТекСтрокаНачисления.Сотрудник;
			Движение.КоличествоДней = (КонецПериода - НачалоПериода) / 86400 + 1;
		КонецЕсли;
		
		Если ТекСтрокаНачисления.ВидРасчета = ПланыВидовРасчетаОклад Тогда 
			
			// регистр ВКМ_ОсновныеНачисления
			Если ТекСтрокаНачисления.Оклад <> 0 Тогда
				Движение = Движения.ВКМ_ОсновныеНачисления.Добавить();
				Движение.Сторно = Ложь;
				Движение.ВидРасчета = ТекСтрокаНачисления.ВидРасчета;
				Движение.ПериодДействияНачало = НачалоДня(НачалоПериода);
				Движение.ПериодДействияКонец = КонецДня(КонецПериода);
				Движение.ПериодРегистрации = Дата;
				Движение.Сотрудник = ТекСтрокаНачисления.Сотрудник;
			КонецЕсли;
			
			// регистр ВКМ_ДополнительныеНачисления
			Если ТекСтрокаНачисления.СуммаЗаВыполненнуюРаботу <> 0 Тогда
				Движение = Движения.ВКМ_ДополнительныеНачисления.Добавить();
				Движение.Сторно = Ложь;
				Движение.ВидРасчета = ПланыВидовРасчетаПремия;
				Движение.ПериодДействияНачало = НачалоДня(НачалоПериода);
				Движение.ПериодДействияКонец = КонецДня(КонецПериода);
				Движение.ПериодРегистрации = Дата;
				Движение.Результат = ТекСтрокаНачисления.СуммаЗаВыполненнуюРаботу;
				Движение.Сотрудник = ТекСтрокаНачисления.Сотрудник;
			КонецЕсли;
			
		КонецЕсли;
				
	КонецЦикла;
	
	Движения.ВКМ_ОсновныеНачисления.Записать();
	
	ТЗСотрудникиОклад = Начисления.Выгрузить(Новый Структура("ВидРасчета", ПланыВидовРасчета.ВКМ_ОсновныеНачисления.Оклад), "Сотрудник");
	
	ТЗСотрудникиОтпуск = Начисления.Выгрузить(Новый Структура("ВидРасчета", ПланыВидовРасчета.ВКМ_ОсновныеНачисления.Отпуск), "Сотрудник");
	
	Если Движения.ВКМ_ОсновныеНачисления.Количество() > 0 Тогда
		
		ТЗОкладыСотрудников = Новый ТаблицаЗначений;
		ТЗНачисленияЗаГод = Новый ТаблицаЗначений;
		
		Если ТЗСотрудникиОклад.Количество() > 0 Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ВКМ_Сотрудники.Ссылка КАК Сотрудник,
			|	ЕСТЬNULL(ВКМ_УсловияОплатыСотрудниковСрезПоследних.Оклад, 0) КАК Оклад
			|ИЗ
			|	Справочник.ВКМ_Сотрудники КАК ВКМ_Сотрудники
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(&Период, ) КАК ВКМ_УсловияОплатыСотрудниковСрезПоследних
			|		ПО ВКМ_Сотрудники.Ссылка = ВКМ_УсловияОплатыСотрудниковСрезПоследних.Сотрудник
			|ГДЕ
			|	НЕ ВКМ_Сотрудники.ПометкаУдаления
			|	И ВКМ_Сотрудники.Ссылка В(&Сотрудники)";
			
			Запрос.УстановитьПараметр("Период", НачалоМесяца(НачалоПериода));
			Запрос.УстановитьПараметр("Сотрудники", ТЗСотрудникиОклад);
			
			РезультатЗапроса = Запрос.Выполнить();		
			
			ТЗОкладыСотрудников = РезультатЗапроса.Выгрузить();
			
		КонецЕсли;
		
		Если ТЗСотрудникиОтпуск.Количество() > 0 Тогда
			
			// Базовый период год, поэтому 12 месяцев
			НачалоБазПериода = НачалоМесяца(ДобавитьМесяц(НачалоПериода, -12));
			
			// Текущий месяц в расчет не берем
			КонецБазПериода  = НачалоМесяца(КонецПериода) - 1;
			
			// Прибавляем один день для расчета количества дней отпуска
			КолДнейОтпуска =  (КонецПериода - НачалоПериода) / 86400 + 1;
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ВКМ_Сотрудники.Ссылка КАК Ссылка
			|ПОМЕСТИТЬ ВТ_Сотрудники
			|ИЗ
			|	Справочник.ВКМ_Сотрудники КАК ВКМ_Сотрудники
			|ГДЕ
			|	НЕ ВКМ_Сотрудники.ПометкаУдаления
			|	И ВКМ_Сотрудники.Ссылка В(&Сотрудники)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_Сотрудники.Ссылка КАК Ссылка,
			|	ВКМ_ОсновныеНачисленияДанныеГрафика.Результат КАК Результат,
			|	ВКМ_ОсновныеНачисленияДанныеГрафика.РабочийДеньФактическийПериодДействия КАК РабочийДеньФактическийПериодДействия
			|ПОМЕСТИТЬ ВТ_Начисления
			|ИЗ
			|	ВТ_Сотрудники КАК ВТ_Сотрудники
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.ВКМ_ОсновныеНачисления.ДанныеГрафика КАК ВКМ_ОсновныеНачисленияДанныеГрафика
			|		ПО ВТ_Сотрудники.Ссылка = ВКМ_ОсновныеНачисленияДанныеГрафика.Сотрудник 
			|			И (ВКМ_ОсновныеНачисленияДанныеГрафика.ПериодДействия МЕЖДУ &ПериодНачало И &ПериодКонец)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ВТ_Сотрудники.Ссылка,
			|	ВКМ_ДополнительныеНачисления.Результат,
			|	NULL
			|ИЗ
			|	ВТ_Сотрудники КАК ВТ_Сотрудники
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.ВКМ_ДополнительныеНачисления КАК ВКМ_ДополнительныеНачисления
			|		ПО ВТ_Сотрудники.Ссылка = ВКМ_ДополнительныеНачисления.Сотрудник
			|ГДЕ
			|	ВКМ_ДополнительныеНачисления.ПериодРегистрации МЕЖДУ &ПериодНачало И &ПериодКонец
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_Начисления.Ссылка КАК Сотрудник,
			|	СУММА(ВТ_Начисления.Результат) КАК Результат,
			|	СУММА(ВТ_Начисления.РабочийДеньФактическийПериодДействия) КАК ОтработаноДней
			|ИЗ
			|	ВТ_Начисления КАК ВТ_Начисления
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_Начисления.Ссылка";
			
			Запрос.УстановитьПараметр("ПериодКонец", КонецБазПериода);
			Запрос.УстановитьПараметр("ПериодНачало", НачалоБазПериода);
			Запрос.УстановитьПараметр("Сотрудники", ТЗСотрудникиОтпуск);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ТЗНачисленияЗаГод = РезультатЗапроса.Выгрузить();
						
		КонецЕсли;
		
		Для Каждого Движение Из Движения.ВКМ_ОсновныеНачисления Цикл
			
			Отбор = Новый Структура("Сотрудник", Движение.Сотрудник);
			
			Если Движение.ВидРасчета = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.Оклад Тогда
				
				План = Движение.ПолучитьДанныеГрафика(ВидПериодаРегистраРасчета.ПериодДействия);
				Факт = Движение.ПолучитьДанныеГрафика(ВидПериодаРегистраРасчета.ФактическийПериодДействия);
				
				ОкладСотрудника = ТЗОкладыСотрудников.НайтиСтроки(Отбор);
				
				Если ОкладСотрудника.Количество() > 0 И План.Количество() > 0 И Факт.Количество() > 0 Тогда
					Если План[0].РабочийДень > 0 Тогда
						Движение.Результат = (ОкладСотрудника[0].Оклад / План[0].РабочийДень * Факт[0].РабочийДень);
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли Движение.ВидРасчета = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.Отпуск Тогда	
				
				НачисленияСотрудника = ТЗНачисленияЗаГод.НайтиСтроки(Отбор);
				
				Движение.БазовыйПериодНачало = НачалоБазПериода;
				Движение.БазовыйПериодКонец = КонецБазПериода;
				
				Если НачисленияСотрудника.Количество() > 0 Тогда
					Если НачисленияСотрудника[0].ОтработаноДней <> 0 Тогда
						Движение.Результат = НачисленияСотрудника[0].Результат / НачисленияСотрудника[0].ОтработаноДней * КолДнейОтпуска;
					КонецЕсли;
				КонецЕсли;
	
			КонецЕсли;
			
		КонецЦикла;
		
		Движения.ВКМ_ОсновныеНачисления.Записать(, Истина);
		
	КонецЕсли;

	Движения.ВКМ_Удержания.Очистить();
	Движения.ВКМ_Удержания.Записывать = Истина;
	
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;
	
	ВидРасчета = ПланыВидовРасчета.ВКМ_Удержания.НДФЛ;
	
	Запрос = Новый Запрос;	
	Запрос.Текст = "ВЫБРАТЬ
	|	ВложенныйЗапрос.Сотрудник КАК Сотрудник,
	|	СУММА(ВложенныйЗапрос.Сумма) * &СтавкаНДФЛ КАК СуммаНДФЛ,
	|	СУММА(ВложенныйЗапрос.Сумма) КАК Сумма
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВКМ_ОсновныеНачисления.Сотрудник КАК Сотрудник,
	|		ВКМ_ОсновныеНачисления.Результат КАК Сумма
	|	ИЗ
	|		РегистрРасчета.ВКМ_ОсновныеНачисления КАК ВКМ_ОсновныеНачисления
	|	ГДЕ
	|		ВКМ_ОсновныеНачисления.Регистратор = &Регистратор
	|		И ВКМ_ОсновныеНачисления.Результат <> 0
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ВКМ_ДополнительныеНачисления.Сотрудник КАК Сотрудник,
	|		ВКМ_ДополнительныеНачисления.Результат КАК Сумма
	|	ИЗ
	|		РегистрРасчета.ВКМ_ДополнительныеНачисления КАК ВКМ_ДополнительныеНачисления
	|	ГДЕ
	|		ВКМ_ДополнительныеНачисления.Регистратор = &Регистратор
	|		И ВКМ_ДополнительныеНачисления.Результат <> 0) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Сотрудник";
	
	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	Запрос.УстановитьПараметр("СтавкаНДФЛ", 0.13);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		// регистр ВКМ_ВзаиморасчетыССотрудниками Приход
		Движение = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Сотрудник = ВыборкаДетальныеЗаписи.Сотрудник;
		Движение.Сумма = ВыборкаДетальныеЗаписи.Сумма - ВыборкаДетальныеЗаписи.СуммаНДФЛ;
		
		// регистр ВКМ_Удержания
		Если ВыборкаДетальныеЗаписи.СуммаНДФЛ <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = Движения.ВКМ_Удержания.Добавить();
		Движение.Сторно = Ложь;
		Движение.ВидРасчета = ВидРасчета;
		Движение.ПериодРегистрации = НачалоМесяца(НачалоПериода);
		Движение.Сотрудник = ВыборкаДетальныеЗаписи.Сотрудник;
		Движение.Результат = ВыборкаДетальныеЗаписи.СуммаНДФЛ;
		
	КонецЦикла;

КонецПроцедуры
//---ВКМ_Макаренко В.П. 04.09.2026

#КонецОбласти

