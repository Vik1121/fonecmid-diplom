#Область СлужебныеПроцедурыИФункции

//+++ВКМ_Макаренко В.П. 04.09.2026
&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Объект.Начисления.Очистить();
	
	ВидРасчета = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.Оклад;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВКМ_Сотрудники.Ссылка КАК Ссылка,
	               |	ВКМ_УсловияОплатыСотрудниковСрезПоследних.Оклад КАК Оклад
	               |ИЗ
	               |	Справочник.ВКМ_Сотрудники КАК ВКМ_Сотрудники
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(&Период, НЕ Сотрудник.ПометкаУдаления) КАК ВКМ_УсловияОплатыСотрудниковСрезПоследних
	               |		ПО ВКМ_Сотрудники.Ссылка = ВКМ_УсловияОплатыСотрудниковСрезПоследних.Сотрудник
	               |ГДЕ
	               |	НЕ ВКМ_Сотрудники.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Период", НачалоМесяца(Объект.НачалоПериода));
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
		НовСтрока = Объект.Начисления.Добавить();
		НовСтрока.Сотрудник = ВыборкаДетальныеЗаписи.Ссылка;
		НовСтрока.ВидРасчета = ВидРасчета;
		НовСтрока.Оклад = ВыборкаДетальныеЗаписи.Оклад;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОпределениеПериодаРасчета()
	Объект.НачалоПериода = НачалоМесяца(Объект.Дата);
	Объект.КонецПериода = КонецМесяца(Объект.Дата);
КонецПроцедуры

&НаСервере
Процедура РассчитатьНаСервере()
	
	Если Объект.Начисления.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	РассчитатьНачисления();
			
КонецПроцедуры

&НаСервере
Процедура РассчитатьНачисления()
	
	МассивСотрудников = ОбщегоНазначения.ВыгрузитьКолонку(Объект.Начисления, "Сотрудник", Истина);
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Значение КАК Сотрудник
	|ПОМЕСТИТЬ ВТ_Сотрудники
	|ИЗ
	|	&Сотрудники КАК Значение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВКМ_ВыполненныеСотрудникомРаботыОбороты.Сотрудник КАК Сотрудник,
	|	ВКМ_ВыполненныеСотрудникомРаботыОбороты.СуммаКОплатеОборот КАК СуммаКОплатеОборот
	|ИЗ
	|	РегистрНакопления.ВКМ_ВыполненныеСотрудникомРаботы.Обороты(&ПериодНачало, &ПериодКонец, , ) КАК ВКМ_ВыполненныеСотрудникомРаботыОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Сотрудники КАК ВТ_Сотрудники
	|		ПО ВКМ_ВыполненныеСотрудникомРаботыОбороты.Сотрудник = ВТ_Сотрудники.Сотрудник";
	
	ТаблицаСотрудников = Новый ТаблицаЗначений;
	ТаблицаСотрудников.Колонки.Добавить("Значение", Новый ОписаниеТипов("СправочникСсылка.ВКМ_Сотрудники"));
	
	Для Каждого Сотрудник Из МассивСотрудников Цикл
		НоваяСтрока = ТаблицаСотрудников.Добавить();
		НоваяСтрока.Значение = Сотрудник;
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ПериодКонец", Объект.КонецПериода);
	Запрос.УстановитьПараметр("ПериодНачало", Объект.НачалоПериода);
	Запрос.УстановитьПараметр("Сотрудники", ТаблицаСотрудников);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выгрузить();
	
	СоответствиеСотрудникСумма = Новый Соответствие;
	
	Для Каждого СтрокаРезультата Из ВыборкаДетальныеЗаписи Цикл
		СоответствиеСотрудникСумма.Вставить(СтрокаРезультата.Сотрудник, СтрокаРезультата.СуммаКОплатеОборот);
	КонецЦикла;
	
	Для Каждого СтрокаНачисления Из Объект.Начисления Цикл
		Сумма = СоответствиеСотрудникСумма.Получить(СтрокаНачисления.Сотрудник);
		Если Сумма <> Неопределено Тогда
			СтрокаНачисления.СуммаЗаВыполненнуюРаботу = Сумма;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
//---ВКМ_Макаренко В.П. 04.09.2026

#КонецОбласти
