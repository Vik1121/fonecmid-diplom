#Область СлужебныеПроцедурыИФункции

//+++ВКМ_Макаренко В.П. 04.09.2026
&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Объект.Начисления.Очистить();
	
	ВидРасчета = ПланыВидовРасчета.ВКМ_ДополнительныеНачисления.Премия;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВКМ_Сотрудники.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ВКМ_Сотрудники КАК ВКМ_Сотрудники
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(&Период, НЕ Сотрудник.ПометкаУдаления) КАК ВКМ_УсловияОплатыСотрудниковСрезПоследних
	               |		ПО ВКМ_Сотрудники.Ссылка = ВКМ_УсловияОплатыСотрудниковСрезПоследних.Сотрудник
	               |ГДЕ
	               |	НЕ ВКМ_Сотрудники.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Период", НачалоМесяца(Объект.Дата));
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
		НовСтрока = Объект.Начисления.Добавить();
		НовСтрока.Сотрудник = ВыборкаДетальныеЗаписи.Ссылка;
		НовСтрока.ВидРасчета = ВидРасчета;
		
	КонецЦикла;
	
КонецПроцедуры
//---ВКМ_Макаренко В.П. 04.09.2026

#КонецОбласти
