// Фоновое создание документов реализации товаров и услуг.
//
// Параметры:
//  ПараметрыВыполнения - Структура - Данные для создания документов.
//  АдресРезультата - Строка - Адрес во временном хранилище.
//
Процедура СоздатьДокументыФоновое(ПараметрыВыполнения, АдресРезультата) Экспорт
	
	ДанныеДляСоздания = ПараметрыВыполнения.ДанныеДляСоздания;
	УспешноСоздано    = 0;
	
	Для Каждого ДанныеДок Из ДанныеДляСоздания Цикл
		Попытка

			НовыйДок = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
			НовыйДок.Дата        	= ДанныеДок.Дата;
			НовыйДок.Организация 	= ДанныеДок.Организация;
			НовыйДок.Контрагент  	= ДанныеДок.Контрагент;
			НовыйДок.Договор 	 	= ДанныеДок.Договор;
			НовыйДок.Ответственный 	= Пользователи.ТекущийПользователь();
			НовыйДок.Комментарий 	= "Создан обработкой Массовое создание актов";
			
			НовыйДок.ВыполнитьАвтозаполнение(); 
			НовыйДок.Записать(РежимЗаписиДокумента.Проведение);
			
			УспешноСоздано = УспешноСоздано + 1;
			
		Исключение
			
			ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("Создание документов реализации", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
			
		КонецПопытки;
		
	КонецЦикла;
	
	СтруктураРезультата = Новый Структура("УспешноСоздано", УспешноСоздано);
	ПоместитьВоВременноеХранилище(СтруктураРезультата, АдресРезультата);
	
КонецПроцедуры
//---ВКМ_Макаренко В.П. 26.08.2026

#КонецОбласти