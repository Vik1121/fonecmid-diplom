Процедура ОтправитьСообщениеТелеграм() Экспорт
	
	МассивУведомлений = ПолучитьУведомления();
	
	Если МассивУведомлений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	HTTPСоединение = Новый HTTPСоединение("api.telegram.org",,,,,,ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение());	
		
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	
	ТокенУправленияТелеграмБотом = Константы.ВКМ_ТокенУправленияТелеграмБотом.Получить();
	
	Для Каждого Уведомление Из МассивУведомлений Цикл
		
		Структура = Новый Структура;
		Структура.Вставить("chat_id", Константы.ВКМ_ИдентификаторГруппыДляОповещения.Получить());
		Структура.Вставить("text", Уведомление.Текст);
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Структура);
		СтрJSON = ЗаписьJSON.Закрыть();
		
		Запрос = Новый HTTPЗапрос("/bot" + ТокенУправленияТелеграмБотом + "/sendMessage", Заголовки);
		Запрос.УстановитьТелоИзСтроки(СтрJSON);
		
		Ответ = HTTPСоединение.ВызватьHTTPМетод("POST", Запрос);
		
		Если Ответ.КодСостояния = 200 Тогда
			УдалитьУведомление(Уведомление);
		Иначе
			ТекстОшибки = "";
			
			ЧтениеJSON = Новый ЧтениеJSON;
    		ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
			
			ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);
   			ЧтениеJSON.Закрыть();
			
			Если ТипЗнч(ДанныеОтвета) = Тип("Структура") Тогда
				
				Если НЕ ДанныеОтвета.ok Тогда
					ТекстОшибки = Строка(ДанныеОтвета.error_code) + ". ";
					ТекстОшибки = ТекстОшибки + ДанныеОтвета.description;
				КонецЕсли;
				
			КонецЕсли;
			
			ЗаписьЖурналаРегистрации("РегламентноеЗадание.ВКМ_ОтправкаУведомлений.Ошибка", УровеньЖурналаРегистрации.Ошибка,,,
				"Не удалось отправить сообщение. Ответ сервера: " + ТекстОшибки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьУведомления()
	
	МассивУведомлений = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВКМ_УведомленияТелеграмБоту.ТекстСообщения КАК ТекстСообщения,
		|	ВКМ_УведомленияТелеграмБоту.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ВКМ_УведомленияТелеграмБоту КАК ВКМ_УведомленияТелеграмБоту
		|ГДЕ
		|	НЕ ВКМ_УведомленияТелеграмБоту.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Структура = Новый Структура;
		Структура.Вставить("Ссылка", ВыборкаДетальныеЗаписи.Ссылка);
		Структура.Вставить("Текст", ВыборкаДетальныеЗаписи.ТекстСообщения);
		МассивУведомлений.Добавить(Структура);
	КонецЦикла;
	
	Возврат МассивУведомлений;
	
КонецФункции

Процедура УдалитьУведомление(Уведомление)
	
	ОбъектУведомление = Уведомление.Ссылка.ПолучитьОбъект();
	
	Если НЕ ОбъектУведомление = Неопределено Тогда
		ОбъектУведомление.УстановитьПометкуУдаления(Истина, Ложь); 
	КонецЕсли;
	
КонецПроцедуры
