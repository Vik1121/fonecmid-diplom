
#Область СлужебныеПроцедурыИФункции

//+++ВКМ_Макаренко В.П. 26.08.2026
// Добавляет реквизиты на форму.
//
// Параметры:
//  Форма - Форма - Форма объекта.
//
Процедура ДобавитьРеквизитНаФорму(Форма) Экспорт
	
	ИмяФормы = Форма.ИмяФормы;
			
	// Справочник Договоры контрагентов
	Если ИмяФормы <> "Справочник.ДоговорыКонтрагентов.Форма.ФормаЭлемента" Тогда
		Возврат;
	КонецЕсли;	
	
	Если Форма.Элементы.Найти("ГруппаПериодДействия") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПолеСтоимость = Форма.Элементы.Вставить("ВКМ_СтоимостьЧасаРаботы", Тип("ПолеФормы"));
	ПолеСтоимость.Вид = ВидПоляФормы.ПолеВвода;
	ПолеСтоимость.Заголовок = "Стоимость часа";
	ПолеСтоимость.ПутьКДанным = "Объект.ВКМ_СтоимостьЧасаРаботы";
	
	ПолеСумма = Форма.Элементы.Вставить("ВКМ_СуммаАбонентскойПлаты", Тип("ПолеФормы"));
	ПолеСумма.Вид = ВидПоляФормы.ПолеВвода;
	ПолеСумма.Заголовок = "Абонентская плата";
	ПолеСумма.ПутьКДанным = "Объект.ВКМ_СуммаАбонентскойПлаты";
	
	ГруппаФормы = Форма.Элементы.Добавить("ГруппаПериодДействия", Тип("ГруппаФормы"));
	ГруппаФормы.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаФормы.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
	ГруппаФормы.Заголовок = "Период действия";
	ГруппаФормы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаФормы.ОтображениеУправления = ОтображениеУправленияОбычнойГруппы.Картинка; 
	ГруппаФормы.ОтображатьЗаголовок = Истина; 
	
	ПолеНачало = Форма.Элементы.Вставить("ВКМ_ПериодДействияНачало", Тип("ПолеФормы"), ГруппаФормы);
	ПолеНачало.Вид = ВидПоляФормы.ПолеВвода;
	ПолеНачало.Заголовок = "с";
	ПолеНачало.ПутьКДанным = "Объект.ВКМ_ПериодДействияНачало";
	
	ПолеКонец = Форма.Элементы.Вставить("ВКМ_ПериодДействияКонец", Тип("ПолеФормы"), ГруппаФормы);
	ПолеКонец.Вид = ВидПоляФормы.ПолеВвода;
	ПолеКонец.Заголовок = "по";
	ПолеКонец.ПутьКДанным = "Объект.ВКМ_ПериодДействияКонец";
	
	ЭтоАбонПлата = Форма.Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание;
	
	ПолеСтоимость.Видимость = ЭтоАбонПлата;
	ПолеСумма.Видимость     = ЭтоАбонПлата;
	ГруппаФормы.Видимость   = ЭтоАбонПлата;
			
КонецПроцедуры
//---ВКМ_Макаренко В.П. 26.08.2026

#КонецОбласти